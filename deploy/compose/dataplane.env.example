# 생성 장비 한 대의 구성값. cp dataplane.env.example .env 후 이 장비에 맞게 고친다.
#
# ★ MIR_MACHINE 은 함대 설정(fleet.yaml)의 machines[].name 과 **반드시 같아야
#   한다**. 인스턴스 이름이 "<machine>-dp<id>" 로 만들어지고, 제어부가 그 이름으로
#   기대와 실측을 잇기 때문이다. 어긋나면 전부 unreachable 로 보인다.
MIR_MACHINE=gen-1

MIR_TAG=dev
MIR_LOG_LEVEL=info

# 인스턴스 하나가 쓸 hugepage 상한(MB).
#
# 이 값 × 인스턴스 수 ≤ 호스트 hugepage 총량이어야 한다. 검증기 기준으로
# 4096MB × 4 = 16GB = hugepages=16 이라 딱 맞는다. 넘으면 나중에 뜨는
# 인스턴스가 기동에 실패한다 — 폴트 시점 SIGBUS 가 아니라 즉시 실패다.
MIR_MEM_MB=4096

# ── PCAP 리플레이(모드 C) 공유 볼륨 ────────────────────────
#
# 데이터플레인이 이 디렉터리를 /var/lib/mir/pcap 로 RO 마운트한다. 리플레이
# 명령의 pcapPath 는 컨테이너 기준 경로다 — 예: 호스트의 ./pcap/cap.pcapng 를
# 재생하려면 pcapPath=/var/lib/mir/pcap/cap.pcapng.
# 파일 내용이 아니라 경로만 제어 채널로 오므로 GB 급 캡처도 그대로 쓴다.
# ★ 제어부 compose 의 MIR_PCAP_DIR 과 **같은 호스트 디렉터리**여야 한다 —
#   제어부가 RW 로 파일을 놓고 데이터플레인이 RO 로 읽는 한 쌍이다.
MIR_PCAP_DIR=/var/lib/mir/pcap

# ── 코어 배치 ──────────────────────────────────────────────
#
# 커널 cmdline 의 isolcpus 와 **같은 출처를 봐야 한다**. 오케스트레이터가
# 골라 주던 시절과 달리 여기 적은 코어가 그대로 EAL lcore 가 된다.
# 검증기: isolcpus=2-23 이므로 0,1 은 OS 몫으로 남기고 2-21 을 4등분했다.
#   인스턴스당 5코어 = main(+제어 스레드) 1 + worker 4
MIR_DP0_CPUSET=2,3,4,5,6
MIR_DP1_CPUSET=7,8,9,10,11
MIR_DP2_CPUSET=12,13,14,15,16
MIR_DP3_CPUSET=17,18,19,20,21

# ── NIC ────────────────────────────────────────────────────
#
# BDF 와 vfio 그룹 번호는 `sudo deploy/host/20-bind-vfio.sh` 가 그대로 출력한다
# ("<bdf> → /dev/vfio/<group>"). 관리 NIC 을 여기 넣지 말 것 — SSH 가 끊긴다.
MIR_DP0_PF=0000:43:00.0
MIR_DP0_VFIO_GROUP=44
MIR_DP1_PF=0000:43:00.1
MIR_DP1_VFIO_GROUP=45
MIR_DP2_PF=0000:43:00.2
MIR_DP2_VFIO_GROUP=46
MIR_DP3_PF=0000:43:00.3
MIR_DP3_VFIO_GROUP=47

# ── 사이드카 포트 ──────────────────────────────────────────
# 호스트 netns 를 쓰므로 인스턴스마다 달라야 한다. fleet.yaml 의 port 와 일치시킬 것.
MIR_DP0_PORT=9100
MIR_DP1_PORT=9101
MIR_DP2_PORT=9102
MIR_DP3_PORT=9103

# ── 몇 개를 띄울 것인가 ────────────────────────────────────
#
# dp0 은 항상 뜨고, 나머지는 여기 적은 프로파일만 뜬다.
# **첫 기동은 비워 두고 dp0 하나만 확인한 뒤 늘릴 것.**
#   COMPOSE_PROFILES=
#   COMPOSE_PROFILES=dp1,dp2,dp3
COMPOSE_PROFILES=dp1,dp2,dp3

# ── 제어 채널 보안 ─────────────────────────────────────────
#
# 사이드카 포트(:9100~)는 장비 밖으로 열린다. 여기 닿는 누구나 라인레이트
# 송신을 시킬 수 있으므로 mTLS 가 기본이다.
#
#   ./deploy/host/50-gen-certs.sh certs/ 10.10.40.121 10.10.40.122
#   # 이 장비 몫만 골라 배치:
#   #   certs/ca.crt, certs/agent-<이 장비 주소>.crt|.key -> agent.crt|agent.key
#
# MIR_TLS_DIR 안에 ca.crt / agent.crt / agent.key 가 있어야 한다.
MIR_TLS_DIR=./certs

# 개발 중 잠깐 끄려면 1. 양쪽 모두 경고를 남긴다.
# ★ 켜 두면 MIR_TLS_* 와 함께 쓸 수 없다 — 제어부/사이드카가 기동을 거부한다.
#   "보안을 켰다고 믿는 채로 평문이 나가는" 상태를 막기 위한 의도적 동작이다.
#MIR_INSECURE=1
