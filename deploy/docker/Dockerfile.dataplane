# mir-dataplane — C/DPDK 데이터플레인.
#
# 빌드 컨텍스트는 **저장소 루트**다 (proto/ 와 dataplane/ 을 모두 참조):
#   docker build -f deploy/docker/Dockerfile.dataplane -t mir/dataplane:dev .
#
# 설계상 이 이미지에는 **C++ 런타임이 들어가지 않는다**. gRPC 는 Go 사이드카가
# 담당하므로 libstdc++·abseil·BoringSSL 이 필요 없다. 만약 이미지에서 그것들이
# 보인다면 설계가 새고 있다는 신호다.

ARG UBUNTU_VERSION=26.04

# ─────────────────────────────────────────────────────────────
# 1단계 — 빌더
# ─────────────────────────────────────────────────────────────
FROM ubuntu:${UBUNTU_VERSION} AS builder

# DPDK 를 소스에서 **명시 버전으로** 빌드한다. 배포판 패키지 버전은 베이스
# 이미지 갱신에 따라 조용히 바뀌는데, 컨테이너화의 목적 자체가 재현성이므로
# 그 변동을 허용하지 않는다.
ARG DPDK_VERSION=25.11

# ★ -march=native 금지. 빌드 머신과 실행 머신의 CPU 가 다르면 SIGILL 로 죽고,
#   컨테이너 이미지는 정의상 다른 머신에서 돈다. Phase 7 에서 타깃 CPU 가
#   확정되면 이 값을 올린다.
ARG MARCH=x86-64-v3

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        meson \
        ninja-build \
        pkg-config \
        python3-pyelftools \
        libnuma-dev \
        libprotobuf-c-dev \
        protobuf-c-compiler \
        libmbedtls-dev \
        wget \
        xz-utils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── mbedTLS 참고 ─────────────────────────────────────────────
# TLS(Phase 5b)는 **순수 C** 인 mbedTLS 로 한다 — gRPC 를 Go 로 뺀 것과 같은
# 이유로 데이터플레인에 C++(OpenSSL/BoringSSL)를 들이지 않기 위해서다.
# Ubuntu 26.04 는 mbedTLS 3.6.x LTS 를 담고 있고 pkg-config 파일이 없어
# meson 은 cc.find_library 로 -lmbedtls -lmbedx509 -lmbedcrypto 를 링크한다.
# ldd 로 확인: libstdc++ 가 붙지 않는다(스모크 검증 완료).

# ── DPDK ─────────────────────────────────────────────────────
# -Dplatform=generic 이 핵심: 이게 없으면 DPDK 가 빌드 머신에 맞춰
# -march=native 로 최적화해 다른 CPU 에서 죽는다.
#
# 드라이버를 전부 빌드해 이미지가 커진다. Phase 7 에서 타깃 NIC 이 확정되면
# -Denable_drivers=net/i40e,net/ice 로 줄여 빌드 시간과 이미지를 크게 줄일 수
# 있다. 지금 줄이지 않는 이유는, 의존 드라이버가 조용히 빠지면 포트가 0개로
# 뜨는 형태로 실패해 원인 파악이 어렵기 때문이다.
RUN wget -q "https://fast.dpdk.org/rel/dpdk-${DPDK_VERSION}.tar.xz" -O /tmp/dpdk.tar.xz \
    && mkdir -p /tmp/dpdk \
    && tar -xJf /tmp/dpdk.tar.xz -C /tmp/dpdk --strip-components=1 \
    && cd /tmp/dpdk \
    && meson setup build \
        --prefix=/usr/local \
        --buildtype=release \
        -Dplatform=generic \
        -Dcpu_instruction_set=${MARCH} \
        -Dtests=false \
        -Denable_docs=false \
    && ninja -C build \
    && ninja -C build install \
    && ldconfig \
    && rm -rf /tmp/dpdk /tmp/dpdk.tar.xz

# ── mir-dataplane ────────────────────────────────────────────
COPY proto/     /src/proto/
COPY dataplane/ /src/dataplane/

RUN cd /src/dataplane \
    && meson setup build --prefix=/usr/local --buildtype=release -Dmarch=${MARCH} \
    && ninja -C build \
    && ninja -C build install

# 실행 환경에서 무엇이 들어갔는지 추적할 수 있게 남긴다.
RUN printf 'dpdk=%s\nmarch=%s\nbuilt=%s\n' \
        "${DPDK_VERSION}" "${MARCH}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        > /usr/local/share/mir-build-info

# ─────────────────────────────────────────────────────────────
# 2단계 — 런타임
# ─────────────────────────────────────────────────────────────
FROM ubuntu:${UBUNTU_VERSION}

# libnuma1     : DPDK 필수
# libatomic1   : PMD(.so)들이 링크한다. **메인 바이너리는 요구하지 않아** ldd 로
#                mir-dataplane 만 봐서는 놓친다. 없으면 EAL 이 플러그인을
#                dlopen 하지 못하고 "Cannot init plugins" → rte_eal_init 실패로
#                끝난다. 실장비에서 실제로 겪은 문제다.
# libprotobuf-c1: 채널 ③ 인코딩
# python3-minimal: dpdk-devbind.py 실행용. 컨테이너 안에서 장치 상태를 못 보면
#                  vfio 문제 디버깅이 매우 괴로워진다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libnuma1 \
        libatomic1 \
        libprotobuf-c1 \
        libmbedtls21 \
        libmbedx509-7 \
        libmbedcrypto16 \
        python3-minimal \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/x86_64-linux-gnu/ /usr/local/lib/x86_64-linux-gnu/
COPY --from=builder /usr/local/bin/mir-dataplane     /usr/local/bin/mir-dataplane
COPY --from=builder /usr/local/bin/dpdk-devbind.py   /usr/local/bin/dpdk-devbind.py
COPY --from=builder /usr/local/share/mir-build-info  /usr/local/share/mir-build-info

# DPDK 는 PMD 를 런타임에 .so 로 로드한다. multiarch 하위 경로는 기본
# ld.so.conf 에 없으므로 명시해야 한다.
RUN echo "/usr/local/lib/x86_64-linux-gnu" > /etc/ld.so.conf.d/dpdk.conf \
    && ldconfig

# hugetlbfs 와 /dev/vfio 접근이 필요해 root 로 실행한다.
# 권한은 securityContext 의 capability(IPC_LOCK/SYS_NICE)로 최소화하며,
# privileged 는 IOMMU 를 못 켜는 경우에만 쓴다 — deploy/host/10-kernel-cmdline.md 3절.
USER root

ENV MIR_IPC_SOCKET=/var/run/mir/dp.sock

ENTRYPOINT ["/usr/local/bin/mir-dataplane"]
